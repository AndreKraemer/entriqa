<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Produktion liegt unter /admin/ der SWA; lokal (dotnet run) unter /. Der Publish-Schritt setzt StaticWebAssetBasePath nicht,
         stattdessen wird die base-href beim Publish per -p:AdminBasePath=/admin/ ersetzt (siehe Pipeline). -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.8" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reine Domänenlogik (QuizEngine.Check) läuft auch im Browser: dieselbe Pfadprüfung wie beim Veröffentlichen, live im Builder. -->
    <ProjectReference Include="..\..\api\src\Entriqa.Domain\Entriqa.Domain.csproj" />
  </ItemGroup>
</Project>
