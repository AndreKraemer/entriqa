<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <!-- TFM, nullability, warnings-as-errors and package versions come from the repository root
         (Directory.Build.props / Directory.Packages.props).
         Produktion liegt unter /admin/ der SWA; lokal (dotnet run) unter /. Der Publish-Schritt setzt StaticWebAssetBasePath nicht,
         stattdessen wird die base-href beim Publish per -p:AdminBasePath=/admin/ ersetzt (siehe Pipeline). -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reine Domänenlogik (QuizEngine.Check) läuft auch im Browser: dieselbe Pfadprüfung wie beim Veröffentlichen, live im Builder. -->
    <ProjectReference Include="..\..\api\src\Entriqa.Domain\Entriqa.Domain.csproj" />
  </ItemGroup>
</Project>
