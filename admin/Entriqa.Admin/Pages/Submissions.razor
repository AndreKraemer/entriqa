@page "/einsendungen"
@page "/einsendungen/{Slug}"
@inject AdminApi Api
@inject Ui T

<h1>@T["Einsendungen"]</h1>

@if (_error is not null) { <p class="error">@_error</p> }
@if (_data is null) { <p>@T["Lade …"]</p> }
else
{
    <div class="filters">
        <select value="@(Slug ?? "")" @onchange="OnSlugChange">
            <option value="">@T["Alle Formulare"]</option>
            @foreach (var f in _forms ?? new()) { <option value="@f.Slug" selected="@(Slug == f.Slug)">@f.Name</option> }
        </select>
        @QuickButton("new", T["Neu seit letztem Besuch"], CountNew)
        @QuickButton("todo", T["Zu bearbeiten"], Count(s => s.Handling == "open"))
        @QuickButton("waiting", T["Wartet auf Bestätigung"], Count(s => s.State == 1))
        @QuickButton("failed", T["Fehler"], Count(s => s.State == 2))
        @if (Slug is not null)
        {
            <a class="btn" href="api/manage/forms/@Slug/export.csv" target="_blank">@T["CSV exportieren"]</a>
        }
        <span class="hint" style="margin-left:auto">
            @if (_lastVisit is { } lv) { <span>@T.F("Letzter Besuch: {0}", lv.ToLocalTime().ToString("dd.MM. HH:mm")) · </span> }
            <a href="" @onclick="MarkVisited" @onclick:preventDefault>@T["alles als gesehen markieren"]</a>
        </span>
    </div>

    <div class="subs-grid">
        <div class="table-scroll">
            <table>
                <thead><tr><th></th><th>@T["Eingang"]</th>@if (Slug is null) { <th>@T["Formular"]</th> }<th>@T["Absender"]</th><th>@T["Status"]</th><th>@T["Bearbeitung"]</th><th>@T["Quiz"]</th></tr></thead>
                <tbody>
                @foreach (var s in Paged)
                {
                    var item = s;
                    <tr class="rowlink @(item.Id == _selectedId ? "row--sel" : "")" @onclick="() => _selectedId = item.Id">
                        <td>@if (IsNew(item)) { <span class="new-dot" title="@T["neu seit letztem Besuch"]"></span> }</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        @if (Slug is null) { <td class="small">@(FormName(item.Slug))</td> }
                        <td>@item.Summary</td>
                        <td><span class="@Labels.StateCss(item.State)">@T[Labels.SubmissionState(item.State)]</span></td>
                        <td>@(item.Handling == "none" ? "–" : item.Handling == "open" ? T["Offen"] : T["Erledigt"])</td>
                        <td>@(item.QuizResultId ?? "–")</td>
                    </tr>
                }
                @if (!Paged.Any())
                {
                    <tr><td colspan="7" class="hint" style="text-align:center;padding:1.5rem">@T["Nichts in dieser Auswahl."]</td></tr>
                }
                </tbody>
            </table>
            <div class="pager">
                <span>@T.F("{0} Einsendungen · Seite {1} von {2}", Filtered.Count, _page, Pages)</span>
                <span>
                    <button class="btn" disabled="@(_page <= 1)" @onclick="() => _page--">@T["‹ Zurück"]</button>
                    <button class="btn" disabled="@(_page >= Pages)" @onclick="() => _page++">@T["Weiter ›"]</button>
                </span>
            </div>
        </div>
        <div class="detail-panel">
            @if (_selectedId is null)
            {
                <div class="card"><p class="hint">@T["Einsendung anklicken, um Angaben und Verarbeitungsschritte zu sehen. Der blaue Punkt markiert, was seit deinem letzten Besuch dazugekommen ist."]</p></div>
            }
            else
            {
                <SubmissionDetailPanel Id="@_selectedId" OnDeleted="OnDeleted" OnChanged="Refresh" />
            }
        </div>
    </div>
}

@code {
    [Parameter] public string? Slug { get; set; }

    private RecentSubmissions? _data;
    private List<FormListItem>? _forms;
    private DateTimeOffset? _lastVisit;
    private string? _error, _selectedId, _quick;
    private int _page = 1;
    private const int PerPage = 15;

    protected override async Task OnParametersSetAsync()
    {
        _selectedId = null; _quick = null; _page = 1;
        await Refresh();
    }

    private async Task Refresh()
    {
        try
        {
            _forms ??= await Api.ListFormsAsync();
            _data = await Api.ListRecentAsync(Slug);
            _lastVisit = _data.LastVisitAt;
            _error = null;
        }
        catch (Exception ex) { _error = Errors.Friendly(ex, T); }
    }

    private bool IsNew(SubmissionListItem s) => _lastVisit is null || s.CreatedAt > _lastVisit;
    private int CountNew => _data!.Items.Count(IsNew);
    private int Count(Func<SubmissionListItem, bool> pred) => _data!.Items.Count(pred);
    private string FormName(string slug) => _forms?.FirstOrDefault(f => f.Slug == slug)?.Name ?? slug;

    private List<SubmissionListItem> Filtered => _data!.Items.Where(s => _quick switch
    {
        "new" => IsNew(s),
        "todo" => s.Handling == "open",
        "waiting" => s.State == 1,
        "failed" => s.State == 2,
        _ => true,
    }).ToList();

    private IEnumerable<SubmissionListItem> Paged => Filtered.Skip((_page - 1) * PerPage).Take(PerPage);
    private int Pages => Math.Max(1, (Filtered.Count + PerPage - 1) / PerPage);

    private RenderFragment QuickButton(string key, string label, int count) => __builder =>
    {
        <button class="btn @(_quick == key ? "btn--primary" : "")"
                @onclick="() => { _quick = _quick == key ? null : key; _page = 1; }">
            @label @if (count > 0) { <span class="count">@count</span> }
        </button>
    };

    private async Task OnSlugChange(ChangeEventArgs e)
    {
        Slug = e.Value?.ToString() is { Length: > 0 } s ? s : null;
        _selectedId = null; _quick = null; _page = 1;
        await Refresh();
    }

    private async Task MarkVisited()
    {
        try { _lastVisit = await Api.MarkVisitedAsync(); if (_quick == "new") _quick = null; }
        catch (Exception ex) { _error = Errors.Friendly(ex, T); }
    }

    private async Task OnDeleted()
    {
        _selectedId = null;
        await Refresh();
    }
}
