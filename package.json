{
  "name": "entriqa",
  "version": "1.1.0",
  "private": true,
  "description": "Local dev environment for Entriqa (Azurite + SWA CLI) and the sample Hugo site; product code lives in src/ and hugo/.",
  "scripts": {
    "dev": "node dev/start.mjs",
    "sample:build": "node scripts/hugo.mjs build",
    "sample:serve": "node scripts/hugo.mjs serve",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.2",
    "azurite": "^3.36.0",
    "hugo-bin": "^0.162.0"
  }
}
