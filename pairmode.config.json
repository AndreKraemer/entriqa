{
  "schemaVersion": 1,
  "workItems": {
    "provider": "github"
  },
  "sourceControl": {
    "provider": "github",
    "defaultBranch": "main",
    "protectedBranches": [
      "main"
    ],
    "branchPattern": "feature/{id}-{slug}"
  },
  "timeTracking": {
    "provider": "none"
  },
  "verify": "node scripts/verify.mjs",
  "verifyFull": "node scripts/verify.mjs --full",
  "candidateExclude": [
    ".claude/",
    "CLAUDE.md",
    "docs/",
    "README.md",
    "LICENSE.md"
  ],
  "forbiddenUrlPatterns": [
    "api.brevo.com",
    "*.core.windows.net",
    "*.webhook.office.com",
    "*.office.com"
  ],
  "riskAreas": [
    "src/Core/Entriqa.Application/Pipeline/",
    "src/Core/Entriqa.Application/Consent/",
    "src/Core/Entriqa.Application/Security/",
    "src/Core/Entriqa.Application/UseCases/ConfirmSubmissionUseCase.cs",
    "src/Core/Entriqa.Application/UseCases/RunHousekeepingUseCase.cs",
    "src/Core/Entriqa.Domain/Consent/",
    "src/Core/Entriqa.Data/",
    "src/Core/Entriqa.Infrastructure/Brevo/",
    "src/Core/Entriqa.Infrastructure/Storage/",
    "src/Hosts/Entriqa.Functions/Public/",
    "src/Hosts/Entriqa.Functions/Ops/",
    "src/Hosts/Entriqa.KeyTool/",
    "scripts/verify.mjs"
  ],
  "implementationMode": {
    "ask": "when-reasoned"
  },
  "skills": {
    "local-dev": "Read .claude/skills/local-dev/SKILL.md before starting, driving or debugging the running app.",
    "test-conventions": "Read .claude/skills/test-conventions/SKILL.md before writing or changing any test, including a story's failing proof.",
    "processing-pipeline": "Read .claude/skills/processing-pipeline/SKILL.md before adding or changing a pipeline step or touching the double opt-in flow.",
    "admin-ui": "Read .claude/skills/admin-ui/SKILL.md before changing the Blazor admin, any Ui.cs string, or the eq-* markup contract."
  }
}
