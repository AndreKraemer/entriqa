@using System.Globalization
@page "/einsendungen"
@page "/einsendungen/{Slug}"
@inject AdminApi Api
@inject NavigationManager Nav
@inject Ui T
@implements IDisposable

<h1>@T["Einsendungen"]</h1>

@if (_error is not null) { <p class="error">@_error</p> }
@if (_data is null) { <p>@T["Lade …"]</p> }
else
{
    <div class="filters">
        <select value="@(Slug ?? "")" @onchange="OnSlugChange">
            <option value="">@T["Alle Formulare"]</option>
            @foreach (var f in _forms ?? new()) { <option value="@f.Slug" selected="@(Slug == f.Slug)">@f.Name</option> }
        </select>
        @QuickButton("new", T["Neu seit letztem Besuch"])
        @QuickButton("todo", T["Zu bearbeiten"])
        @QuickButton("waiting", T["Wartet auf Bestätigung"])
        @QuickButton("failed", T["Fehler"])
        @* The personal filter is one concept with two ways in: the chip is this picker set to the
           signed-in admin. The name - not a "me" marker - goes into the address, so a personal
           filter stays shareable and SubmissionSelection stays free of any notion of identity. *@
        @if (_me is { Length: > 0 } me)
        {
            var mine = CountPersonal(me);
            <button class="btn @(_selection.IsPersonal(me) ? "btn--primary" : "")"
                    @onclick="() => Go(_selection.TogglePersonal(me))">
                @T["Meine offenen"] @if (mine > 0) { <span class="count">@mine</span> }
            </button>
        }
        <select value="@(_selection.Assignee ?? "")" @onchange="OnAssigneeChange" title="@T["Bearbeiter"]">
            <option value="">@T["Alle Bearbeiter"]</option>
            <option value="@SubmissionSelection.Nobody" selected="@(_selection.Assignee == SubmissionSelection.Nobody)">@T["Niemand"]</option>
            @* "Niemand" has its own option above, so it is not handed in as a name to keep. *@
            @foreach (var a in Labels.AssigneeChoices(_admins, _selection.Assignee == SubmissionSelection.Nobody ? null : _selection.Assignee))
            {
                <option value="@a" selected="@(_selection.Assignee == a)">@a</option>
            }
        </select>
        @* The term is the one narrowing the endpoint applies, so it travels to the server; the range and
           the chips narrow what is already here. Both nevertheless live in the address, or a shared link
           would promise a selection the list does not show (#11). *@
        <input type="search" style="min-width:240px" value="@(_selection.Search ?? "")"
               placeholder="@T["Suchen (E-Mail, Name, Feldwerte)"]" aria-label="@T["Suchen (E-Mail, Name, Feldwerte)"]"
               @oninput="e => Debounce(_selection with { Search = Text(e), Page = 1 })" />
        <input type="date" title="@T["Eingang ab"]" aria-label="@T["Eingang ab"]" value="@Iso(_selection.From)"
               @onchange="e => Go(_selection with { From = Day(e), Page = 1 })" />
        <input type="date" title="@T["Eingang bis"]" aria-label="@T["Eingang bis"]" value="@Iso(_selection.To)"
               @onchange="e => Go(_selection with { To = Day(e), Page = 1 })" />
        @if (Slug is not null)
        {
            <a class="btn" href="api/manage/forms/@Slug/export.csv" target="_blank">@T["CSV exportieren"]</a>
        }
        <span class="hint" style="margin-left:auto">
            @if (_lastVisit is { } lv) { <span>@T.F("Letzter Besuch: {0}", lv.ToLocalTime().ToString("dd.MM. HH:mm")) · </span> }
            <a href="" @onclick="MarkVisited" @onclick:preventDefault>@T["alles als gesehen markieren"]</a>
        </span>
    </div>

    @if (_selection.SearchSummary(T, _scanned, _capped) is { } summary)
    {
        <p class="hint">@summary</p>
    }

    <p class="hint">@T["Einsendung anklicken, um Angaben und Verarbeitungsschritte zu sehen. Der blaue Punkt markiert, was seit deinem letzten Besuch dazugekommen ist."]</p>

    <div class="table-scroll">
        <table>
            <thead><tr><th></th><th>@T["Eingang"]</th>@if (Slug is null) { <th>@T["Formular"]</th> }<th>@T["Absender"]</th><th>@T["Status"]</th><th>@T["Bearbeitung"]</th><th>@T["Bearbeiter"]</th><th>@T["Quiz"]</th><th>@T["Aufbewahrung"]</th></tr></thead>
            <tbody>
            @foreach (var s in Paged)
            {
                var item = s;
                @* The link is the control, not the row: a <tr> cannot carry role="link" without dropping the
                   row and its cells out of the table for assistive technology. The anchor takes focus, answers
                   Enter and can be opened in a new tab; the row's @onclick is the mouse convenience on top (AC1). *@
                <tr class="rowlink" @onclick="() => Open(item.Id)">
                    <td>@if (SubmissionSelection.IsNew(item, _lastVisit)) { <span class="new-dot" title="@T["neu seit letztem Besuch"]"></span> }</td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    @if (Slug is null) { <td class="small">@(FormName(item.Slug))</td> }
                    @* The link handles its own click - including ctrl/cmd/shift, where the browser opens a new
                       tab. Without stopping it here the row would navigate this tab as well. *@
                    <td @onclick:stopPropagation="true"><a href="@Shown.DetailUrl(item.Id)">@item.Summary</a></td>
                    <td><span class="@Labels.StateCss(item.State)">@T[Labels.SubmissionState(item.State)]</span></td>
                    <td>@(item.Handling == "none" ? "–" : item.Handling == "open" ? T["Offen"] : T["Erledigt"])</td>
                    <td>
                        @if (item.Assignee is { Length: > 0 } who)
                        {
                            <span class="avatar avatar--sm" title="@who">@Labels.Initials(who)</span>
                        }
                        else { <span class="hint">–</span> }
                    </td>
                    <td>@(item.QuizResultId ?? "–")</td>
                    <td>
                        @if (item.RetainedIndefinitely)
                        {
                            <span class="chip chip--ok">@T["Dauerhaft"]</span>
                        }
                        else if (SubmissionRetentionDisplay.ExpiresWithinHighlightWindow(item, DateTimeOffset.UtcNow))
                        {
                            <span class="chip chip--wait">@T.F("Läuft in {0} Tagen ab", SubmissionRetentionDisplay.DaysUntilExpiry(item, DateTimeOffset.UtcNow))</span>
                        }
                        else
                        {
                            <span class="hint">@item.ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                        }
                    </td>
                </tr>
            }
            @if (!Paged.Any())
            {
                <tr><td colspan="9" class="hint" style="text-align:center;padding:1.5rem">@_selection.EmptyMessage(T)</td></tr>
            }
            </tbody>
        </table>
        <div class="pager">
            <span>@T.F("{0} Einsendungen · Seite {1} von {2}", Filtered.Count, Shown.Page, Pages)</span>
            <span>
                <button class="btn" disabled="@(Shown.Page <= 1)" @onclick="() => Go(Shown with { Page = Shown.Page - 1 })">@T["‹ Zurück"]</button>
                <button class="btn" disabled="@(Shown.Page >= Pages)" @onclick="() => Go(Shown with { Page = Shown.Page + 1 })">@T["Weiter ›"]</button>
            </span>
        </div>
    </div>
}

@code {
    [Parameter] public string? Slug { get; set; }

    private RecentSubmissions? _data;
    private List<FormListItem>? _forms;
    private List<string>? _admins;
    private string? _me;
    private DateTimeOffset? _lastVisit;
    private int _scanned;
    private bool _capped;
    private CancellationTokenSource? _typing;
    private string? _error;
    private string _path = "";

    /// <summary>Form, quick filter and page - read from the address, never held here. That is what lets the
    /// detail page hand the same selection back when the reader returns (AC2).</summary>
    private SubmissionSelection _selection = SubmissionSelection.Default;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _typing?.Cancel();
        _typing?.Dispose();
    }

    /// <summary>
    /// Every keystroke would otherwise cost a scan of the whole table. The last one wins: a typist who
    /// keeps going cancels the request they have already outrun.
    /// </summary>
    private async Task Debounce(SubmissionSelection target)
    {
        _typing?.Cancel();
        _typing?.Dispose();
        _typing = new CancellationTokenSource();
        var token = _typing.Token;
        try { await Task.Delay(400, token); }
        catch (OperationCanceledException) { return; }
        Go(target);
    }

    private static string? Text(ChangeEventArgs e) => e.Value?.ToString()?.Trim() is { Length: > 0 } v ? v : null;

    private static DateOnly? Day(ChangeEventArgs e) =>
        DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
            ? d
            : null;

    private static string Iso(DateOnly? day) => day?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";

    protected override Task OnParametersSetAsync() => ApplyAddress();

    /// <summary>
    /// The router re-renders on a path change and OnParametersSetAsync follows it. It stays silent when
    /// only the query changes - which is every quick filter and every page turn here, since the form is
    /// the route and the rest is the query. Without this the address moves and the list does not, and the
    /// row links keep pointing at the selection the reader has already left.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (new Uri(e.Location).AbsolutePath != _path) return;      // path change: the router has it
        _ = InvokeAsync(async () => { await ApplyAddress(); StateHasChanged(); });
    }

    private async Task ApplyAddress()
    {
        var uri = new Uri(Nav.Uri);
        _path = uri.AbsolutePath;
        var selection = SubmissionSelection.FromQuery(Slug, uri.Query);
        // Only the form decides what the endpoint returns; filtering and paging happen on what is already
        // here, so switching a filter or turning a page must not cost a round trip.
        var reload = _data is null || selection.NeedsReload(_selection);
        _selection = selection;
        if (reload) await Refresh();
    }

    private async Task Refresh()
    {
        try
        {
            _forms ??= await Api.ListFormsAsync();
            _me ??= (await Api.GetMeAsync())?.UserDetails;
            if (_selection.Search is { } term)
            {
                var hits = await Api.SearchSubmissionsAsync(_selection.Slug, term);
                _data = new RecentSubmissions(hits.Items, hits.LastVisitAt);
                (_scanned, _capped) = (hits.Scanned, hits.Capped);
            }
            else
            {
                _data = await Api.ListRecentAsync(_selection.Slug);
                (_scanned, _capped) = (0, false);
            }
            // After the inbox call, not before: that request is what records the caller as having been
            // here, so asking earlier would leave the signed-in admin out of their own picker until the
            // next load (#13).
            _admins ??= await Api.ListAdminsAsync();
            _lastVisit = _data.LastVisitAt;
            _error = null;
        }
        catch (Exception ex) { _error = Errors.Friendly(ex, T); }
    }

    private string FormName(string slug) => _forms?.FirstOrDefault(f => f.Slug == slug)?.Name ?? slug;

    /// <summary>The badge counts come from the selection itself - a second copy of the filter here would be
    /// the one nothing tests, and the counts could then disagree with what the button shows.</summary>
    private int CountFor(string quick) => _selection.ToggleChip(quick).Select(_data!.Items, _lastVisit).Count;

    /// <summary>The badge counts exactly the selection the chip leads to - one expression, so the two cannot drift.</summary>
    private int CountPersonal(string who) => SubmissionSelection.Personal(who).Select(_data!.Items, _lastVisit).Count;

    private IReadOnlyList<SubmissionListItem> Filtered => _selection.Select(_data!.Items, _lastVisit);

    /// <summary>The selection as it can actually be shown: the address may name a page this selection has not got.</summary>
    private SubmissionSelection Shown => _selection.Clamped(Filtered);

    private IReadOnlyList<SubmissionListItem> Paged => Shown.PageSlice(Filtered);
    private int Pages => SubmissionSelection.PageCount(Filtered);

    private void Go(SubmissionSelection selection) => Nav.NavigateTo(selection.ListUrl());

    private void Open(string id) => Nav.NavigateTo(Shown.DetailUrl(id));

    private RenderFragment QuickButton(string key, string label) => __builder =>
    {
        var count = CountFor(key);
        <button class="btn @(_selection.HasChip(key) ? "btn--primary" : "")"
                @onclick="() => Go(_selection.ToggleChip(key))">
            @label @if (count > 0) { <span class="count">@count</span> }
        </button>
    };

    // Every narrowing survives a change of form - "my open ones in this form", "what I searched for, in
    // this form" - because silently dropping one would widen the list the reader is looking at. Only the
    // quick filters go, since the form picker is how a reader leaves them behind.
    private void OnSlugChange(ChangeEventArgs e) =>
        Go(_selection with { Slug = e.Value?.ToString() is { Length: > 0 } s ? s : null, Quick = null, Page = 1 });

    private void OnAssigneeChange(ChangeEventArgs e) =>
        Go(_selection with { Assignee = e.Value?.ToString() is { Length: > 0 } a ? a : null, Page = 1 });

    private async Task MarkVisited()
    {
        try
        {
            _lastVisit = await Api.MarkVisitedAsync();
            if (_selection.HasChip("new")) Go(_selection.ToggleChip("new"));
        }
        catch (Exception ex) { _error = Errors.Friendly(ex, T); }
    }
}
