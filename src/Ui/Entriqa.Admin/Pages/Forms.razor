@page "/"
@inject AdminApi Api
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject Ui T

@* "Neues Formular" sits in the header, above the table, so it is reachable without scrolling past the
   list however long it is (#19, AC 6); it opens a dialog rather than an inline block that would push
   the list down on every visit (AC 7). *@
<div class="page-head">
    <h1>@T["Formulare"]</h1>
    @if (_forms is not null)
    {
        <button class="btn btn--primary" @onclick="() => _createOpen = true">@T["Neues Formular"]</button>
    }
</div>

@if (_error is not null) { <p class="error">@_error</p> }
@if (_forms is null) { <p>@T["Lade …"]</p> }
else
{
    @if (_forms.Count > 8)
    {
        <div class="filters">
            <input placeholder="@T["Suchen (Slug, Name)"]" style="min-width:240px" value="@_search"
                   @oninput="e => { _search = e.Value?.ToString() ?? string.Empty; _page = 1; }" />
            <span class="hint" style="margin-left:auto">@T.F("{0} Formulare", Filtered.Count)</span>
        </div>
    }
    <div class="table-scroll">
    <table>
        <thead><tr><th>Slug</th><th>Name</th><th>@T["Typ"]</th><th>@T["Status"]</th><th>@T["Version"]</th><th>@T["Einsendungen · 14 Tage"]</th><th>@T["Geändert"]</th><th></th></tr></thead>
        <tbody>
        @foreach (var f in Paged)
        {
            var activity = _activity?.GetValueOrDefault(f.Slug);
            <tr>
                <td><code>@f.Slug</code></td>
                <td>@f.Name</td>
                <td>@T[TypeLabel(f.Type)]</td>
                <td><span class="chip @(f.Status == "published" ? "chip--ok" : "chip--busy")">@(f.Status == "published" ? T["Veröffentlicht"] : T["Entwurf"])</span></td>
                <td>@(f.PublishedVersion > 0 ? $"v{f.PublishedVersion}" : "–")</td>
                <td>
                    @if (activity is { Total: > 0 })
                    {
                        <span>@activity.Total</span>
                        <span class="spark">
                            @foreach (var (d, i) in activity.Daily.Select((d, i) => (d, i)))
                            {
                                <i class="@(i >= 7 ? "spark--recent" : "")" style="height:@(SparkHeight(activity.Daily, d))px"></i>
                            }
                        </span>
                        <div class="hint">@T.F("{0} in 7 Tagen", activity.Daily.Skip(7).Sum())</div>
                    }
                    else { <span>–</span> }
                </td>
                <td>@f.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    @* Split button: the primary opens the editor, the chevron a native popover menu with the
                       rest. The popover renders in the top layer, so it escapes the table's overflow clipping;
                       light-dismiss closes it on Escape or an outside click without triggering anything (AC 5),
                       and CSS anchor positioning places it under the toggle - no JS. The menu is out of the
                       row's flow, so a row's height never depends on how many actions it has (AC 2). *@
                    <div class="row-actions">
                        <a class="btn split-main" href="forms/@f.Slug"><Icon Name="pencil" /> @T["Bearbeiten"]</a>
                        <button class="btn split-toggle" style="anchor-name:--eq-rowmenu-@f.Slug"
                                popovertarget="eq-rowmenu-@f.Slug" aria-haspopup="true"
                                aria-label="@T.F("Weitere Aktionen für {0}", f.Name)"><Icon Name="chevron-down" /></button>
                    </div>
                    <div popover id="eq-rowmenu-@f.Slug" class="row-menu" role="menu" style="position-anchor:--eq-rowmenu-@f.Slug">
                        <a class="row-menu__item" role="menuitem" href="einsendungen/@f.Slug"><Icon Name="inbox" /> @T["Einsendungen"]</a>
                        <a class="row-menu__item" role="menuitem" href="termine/@f.Slug"><Icon Name="calendar" /> @T["Termine"]</a>
                        <button class="row-menu__item" role="menuitem" disabled="@(f.Status != "published")"
                                popovertarget="eq-rowmenu-@f.Slug" popovertargetaction="hide"
                                @onclick="() => _snippetSlug = f.Slug"><Icon Name="code" /> @T["Einbetten"]</button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>

    @if (Pages > 1)
    {
        <div class="pager">
            <span>@T.F("Seite {0} von {1}", _page, Pages)</span>
            <span>
                <button class="btn" disabled="@(_page <= 1)" @onclick="() => _page--">@T["‹ Zurück"]</button>
                <button class="btn" disabled="@(_page >= Pages)" @onclick="() => _page++">@T["Weiter ›"]</button>
            </span>
        </div>
    }

}

@if (_createOpen)
{
    <div class="scrim" @onclick="() => _createOpen = false">
        <div class="modal" @onclick:stopPropagation>
            <h2 style="margin-top:0">@T["Neues Formular"]</h2>
            <label class="create-field ltext-label">@T["Name des neuen Formulars"]
                <input @bind="_newName" @bind:event="oninput" />
            </label>
            <label class="create-field ltext-label">@T["Typ"]
                <select @bind="_newType">
                    <option value="contact">@T["Kontakt"]</option>
                    <option value="leadmagnet">@T["Lead-Magnet"]</option>
                    <option value="quiz">@T["Quiz"]</option>
                </select>
            </label>
            @if (NewSlug.Length > 0) { <p class="hint"><code>/f/@NewSlug/</code></p> }
            @if (_forms!.Any(f => f.Slug == NewSlug)) { <p class="hint">@T["Slug existiert schon."]</p> }
            <div class="actions">
                <button class="btn" @onclick="() => { _importJson = string.Empty; _importDialog = true; _createOpen = false; }">@T["Aus JSON importieren …"]</button>
                <span class="spacer"></span>
                <button class="btn" @onclick="() => _createOpen = false">@T["Abbrechen"]</button>
                <button class="btn btn--primary" disabled="@(NewSlug.Length == 0 || _forms!.Any(f => f.Slug == NewSlug))" @onclick="CreateNew">@T["Anlegen"]</button>
            </div>
        </div>
    </div>
}

@if (_snippetSlug is not null)
{
    <div class="scrim" @onclick="() => _snippetSlug = null">
        <div class="modal" @onclick:stopPropagation>
            <h2 style="margin-top:0">@T.F("Einbetten: {0}", _snippetSlug)</h2>
            <p class="hint">@T["Shortcode in eine Hugo-Seite einfügen oder die eigenständige Adresse teilen. Beides zeigt immer die zuletzt veröffentlichte Version."]</p>
            <div class="snip"><code>{{&lt; entriqa "@_snippetSlug" &gt;}}</code><button class="btn" @onclick="@(() => Copy($"{{{{< entriqa \"{_snippetSlug}\" >}}}}"))">@T["Kopieren"]</button></div>
            <div class="snip"><code>/f/@_snippetSlug/</code><button class="btn" @onclick="@(() => Copy($"/f/{_snippetSlug}/"))">@T["Kopieren"]</button></div>
            <div class="actions"><button class="btn btn--primary" @onclick="() => _snippetSlug = null">@T["Schließen"]</button></div>
        </div>
    </div>
}

@if (_importDialog)
{
    <div class="scrim" @onclick="() => _importDialog = false">
        <div class="modal" @onclick:stopPropagation>
            <h2 style="margin-top:0">@T["Formular aus JSON importieren"]</h2>
            <p class="hint">@T["Definitions-JSON einfügen (z. B. aus dem Expertenmodus einer anderen Instanz kopiert). Es entsteht ein Entwurf unter dem Slug aus dem JSON – veröffentlicht wird erst nach deiner Prüfung."]</p>
            @if (_importError is not null) { <p class="error">@_importError</p> }
            <textarea class="editor" style="min-height:220px" spellcheck="false" @bind="_importJson" @bind:event="oninput"></textarea>
            <div class="actions">
                <button class="btn" @onclick="() => _importDialog = false">@T["Abbrechen"]</button>
                <span class="spacer"></span>
                <button class="btn btn--primary" disabled="@(_importJson.Trim().Length == 0 || _busy)" @onclick="ImportJson">@T["Importieren"]</button>
            </div>
        </div>
    </div>
}

@code {
    private List<FormListItem>? _forms;
    private Dictionary<string, FormActivity>? _activity;
    private string? _error, _snippetSlug, _importError;
    private string _newName = "";
    private string _newType = "contact";
    private string _search = "";
    private string _importJson = "";
    private bool _importDialog, _busy, _createOpen;
    private int _page = 1;
    private const int PerPage = 20;

    private List<FormListItem> Filtered => _forms!
        .Where(f => _search.Length == 0
            || f.Slug.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || f.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();
    private IEnumerable<FormListItem> Paged => Filtered.Skip((Math.Min(_page, Pages) - 1) * PerPage).Take(PerPage);
    private int Pages => Math.Max(1, (Filtered.Count + PerPage - 1) / PerPage);

    private async Task ImportJson()
    {
        _busy = true; _importError = null;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(_importJson);
            var slug = doc.RootElement.TryGetProperty("slug", out var s) ? s.GetString() : null;
            if (string.IsNullOrWhiteSpace(slug)) { _importError = T["Das JSON hat keinen 'slug'."]; return; }
            if (_forms!.Any(f => f.Slug == slug)) { _importError = T.F("Slug '{0}' existiert schon – im JSON umbenennen.", slug); return; }
            await Api.SaveDraftAsync(slug, _importJson);
            Nav.NavigateTo($"forms/{slug}");
        }
        catch (System.Text.Json.JsonException je) { _importError = T.F("Kein gültiges JSON: {0}", je.Message); }
        catch (Exception ex) { _importError = Errors.Friendly(ex, T); }
        finally { _busy = false; }
    }

    private string NewSlug => FormTemplates.Slugify(_newName);

    private static string TypeLabel(string type) => type switch
    {
        "contact" => "Kontakt", "leadmagnet" => "Lead-Magnet", "quiz" => "Quiz", _ => type,
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _forms = await Api.ListFormsAsync();
            _activity = await Api.GetActivityAsync();
        }
        catch (Exception ex) { _error = Errors.Friendly(ex, T); }
    }

    private static int SparkHeight(List<int> daily, int value)
    {
        var max = Math.Max(daily.Max(), 1);
        return Math.Max(2, (int)Math.Round(value * 16.0 / max));
    }

    private void CreateNew() => Nav.NavigateTo($"forms/{NewSlug}?typ={_newType}");

    private async Task Copy(string text)
    {
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", text); } catch { /* the clipboard needs HTTPS and focus */ }
    }
}
